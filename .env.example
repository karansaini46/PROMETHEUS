# ==============================================================================
# PROMETHEUS System Configuration Template (.env.example)
# Copy this file to .env and configure for your local environment.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Application Environment & Server
PROMETHEUS_ENV=development
API_HOST=0.0.0.0
API_PORT=8001
API_SECRET_KEY=dev-secret-key-replace-with-secure-value-in-production-min-32-chars
LOG_LEVEL=INFO

# Authoritative Persistence (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://prometheus:prometheus@localhost:5432/prometheus_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
ENABLE_VECTOR_SEARCH=false

# Model Providers (At least one provider required for AI agent loops)
DEFAULT_MODEL=anthropic/claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local Model Inference (Fallback / Offline Mode via Ollama / vLLM)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5-coder:7b

# Docker Execution Sandbox
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_IMAGE=prometheus-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MEMORY_LIMIT=4g
SANDBOX_CPU_LIMIT=2.0
SANDBOX_PIDS_LIMIT=256
WORKTREE_BASE_DIR=./data/worktrees

# OpenTelemetry & Observability
OTEL_SERVICE_NAME=prometheus-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_ENABLED=false

# Next.js Dashboard Configuration
NEXT_PUBLIC_API_URL=http://localhost:8001
DASHBOARD_PORT=3001
