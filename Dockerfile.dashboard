# ==============================================================================
# PROMETHEUS Next.js Dashboard Containerfile
# Multi-stage non-root container for the Next.js control plane
# ==============================================================================

FROM node:20-alpine AS builder

WORKDIR /workspace

# Install dependencies and build shared-types package
COPY packages/shared-types packages/shared-types
RUN cd packages/shared-types && npm ci && npm run build

# Install dependencies and build dashboard
COPY apps/dashboard apps/dashboard
WORKDIR /workspace/apps/dashboard
RUN npm ci && npm run build

# ==============================================================================
# Production Runner Stage
# ==============================================================================
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000

# Create non-root system user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy shared-types and dashboard artifacts
COPY --from=builder /workspace/packages/shared-types /workspace/packages/shared-types
COPY --from=builder /workspace/apps/dashboard/package.json ./package.json
COPY --from=builder /workspace/apps/dashboard/node_modules ./node_modules
COPY --from=builder /workspace/apps/dashboard/.next ./.next
COPY --from=builder /workspace/apps/dashboard/public ./public

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:3000/api/health || exit 1

CMD ["npm", "start"]
