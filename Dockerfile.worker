# ==============================================================================
# PROMETHEUS Background Worker & Supervisor Containerfile
# Hardened non-root Python 3.12 worker container
# ==============================================================================

FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 1000 prometheus && \
    useradd -u 1000 -g prometheus -s /bin/bash -m prometheus

WORKDIR /app

COPY pyproject.toml ./
RUN pip install --upgrade pip && \
    pip install --extra-index-url https://download.pytorch.org/whl/cpu -e ".[dev]"

COPY --chown=prometheus:prometheus . .

RUN mkdir -p /app/data/worktrees /app/artifacts && \
    chown -R prometheus:prometheus /app/data /app/artifacts

USER prometheus

CMD ["python", "-m", "services.api.worker"]
