# ==============================================================================
# PROMETHEUS Hardened Sandbox Execution Image
# Pinned ephemeral sandbox environment for executing untrusted tests & patches
# ==============================================================================

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Install minimal test toolchain and git
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install standard test runners
RUN pip install --upgrade pip && \
    pip install pytest pytest-cov pytest-asyncio

# Create non-root unprivileged sandbox execution user
RUN groupadd -g 1000 sandbox && \
    useradd -u 1000 -g sandbox -s /bin/sh -d /workspace -m sandbox

WORKDIR /workspace

USER sandbox:sandbox

CMD ["pytest"]
